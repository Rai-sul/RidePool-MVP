# Server Configuration
NODE_ENV=development
PORT=3000

# Supabase Configuration
# IMPORTANT: Replace these with your actual Supabase credentials
# Get these from: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# =============================================================================
# MAPS CONFIGURATION (Choose one)
# =============================================================================

# Google Maps (https://console.cloud.google.com/apis/credentials)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Mapbox Alternative (https://account.mapbox.com/access-tokens/)
MAPBOX_ACCESS_TOKEN=pk.your-mapbox-access-token-here

# Which provider to use for routing: 'google' or 'mapbox'
ROUTING_PROVIDER=mapbox

# =============================================================================
# H3 GEOSPATIAL CONFIGURATION
# =============================================================================
H3_RESOLUTION_PICKUP=9
H3_RESOLUTION_DESTINATION=7
H3_RESOLUTION_DRIVER=8
H3_SEARCH_RADIUS=2
H3_WORKER_POOL_SIZE=4

# =============================================================================
# CACHING (Redis)
# =============================================================================
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=ridepool:
REDIS_DEFAULT_TTL=300

# =============================================================================
# SECURITY & RATE LIMITING
# =============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# =============================================================================
# NOTIFICATIONS (Choose one)
# =============================================================================

# Option 1: Knock.app (Recommended)
# Get from: https://dashboard.knock.app/settings/api-keys
KNOCK_API_KEY=sk_test_your-knock-api-key
KNOCK_PUSH_CHANNEL_ID=your-push-channel-id

# Option 2: Direct FCM
# FCM_SERVER_KEY=your-fcm-server-key-here
# FCM_PROJECT_ID=your-firebase-project-id

# =============================================================================
# PAYMENT GATEWAYS
# =============================================================================

# SSLCommerz (https://developer.sslcommerz.com/)
SSLCOMMERZ_STORE_ID=your-store-id
SSLCOMMERZ_STORE_PASSWORD=your-store-password
SSLCOMMERZ_IS_SANDBOX=true

# bKash (https://developer.bka.sh/)
BKASH_APP_KEY=your-app-key
BKASH_APP_SECRET=your-app-secret
BKASH_USERNAME=your-username
BKASH_PASSWORD=your-password
BKASH_IS_SANDBOX=true

# =============================================================================
# BUSINESS RULES
# =============================================================================
LOOKUP_TIME_MS=180000
COOLDOWN_DURATION_MS=420000
PLATFORM_SURCHARGE_BDT=10
DRIVER_COMMISSION_RATE=0.20
PROMISE_MONEY_AMOUNT_BDT=50
MAX_CANCELLATIONS_BEFORE_PENALTY=3

# =============================================================================
# LOGGING & MONITORING
# =============================================================================
LOG_LEVEL=info
TRACE_SAMPLE_RATE=0.1

# Prometheus (for metrics)
METRICS_ENABLED=true
METRICS_PORT=9090

# =============================================================================
# OPERATIONAL
# =============================================================================
SHUTDOWN_TIMEOUT=30000

# Session secret (for signed cookies if used)
SESSION_SECRET=your-random-session-secret-min-32-chars

# JWT Configuration (if not using Supabase Auth)
# JWT_SECRET=your-jwt-secret-key
# JWT_EXPIRES_IN=7d

