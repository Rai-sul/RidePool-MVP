import { useState } from "react";
import { SafeAreaView, StatusBar, View } from "react-native";
import { Pool } from "./components/pool/PoolCard.native";
import { RatingFeedbackDialog } from "./components/pool/RatingFeedbackDialog.native";
import { LoginScreen } from "./components/screens/LoginScreen.native";
import { RegisterScreen } from "./components/screens/RegisterScreen.native";
import { EarningsScreen } from "./components/screens/EarningsScreen.native";
import { ProfileScreen } from "./components/screens/ProfileScreen.native";
import { SettingsScreen } from "./components/screens/SettingsScreen.native";
import { ContactInfoScreen } from "./components/screens/ContactInfoScreen.native";
import { SafetySecurityScreen } from "./components/screens/SafetySecurityScreen.native";
import { HelpSupportScreen } from "./components/screens/HelpSupportScreen.native";
import { AppHeader } from "./components/layout/AppHeader.native";
import { BottomNavigation } from "./components/layout/BottomNavigation.native";
import { HomeScreen } from "./components/home/HomeScreen.native";
import { ActiveRideScreen } from "./components/home/ActiveRideScreen.native";
import { PromotionsBanner } from "./components/driver/PromotionsBanner.native";
import { mockPools } from "./data/mockPools";
import { toast } from "sonner";
import { Toaster } from "./components/ui/sonner";

type Screen = 'home' | 'earnings' | 'profile' | 'settings' | 'contactInfo' | 'safety' | 'help';
type AuthScreen = 'login' | 'register';

export default function App() {
  // Auth state
  const [authScreen, setAuthScreen] = useState<AuthScreen>('login');
  const [isLoggedIn, setIsLoggedIn] = useState(false);

  // Driver state
  const [isOnline, setIsOnline] = useState(true);
  const [currentScreen, setCurrentScreen] = useState<Screen>('home');
  
  // Pool state
  const [pools, setPools] = useState<Pool[]>(mockPools);
  const [activePool, setActivePool] = useState<Pool | null>(null);
  const [selectedPoolForDetails, setSelectedPoolForDetails] = useState<Pool | null>(null);
  const [completedPool, setCompletedPool] = useState<Pool | null>(null);
  
  // UI state
  const [priorityLocation, setPriorityLocation] = useState<string | null>(null);
  const [showPriorityDialog, setShowPriorityDialog] = useState(false);
  const [showPromotions, setShowPromotions] = useState(false);
  const [showNavigationMode, setShowNavigationMode] = useState(false);
  const [showRatingDialog, setShowRatingDialog] = useState(false);
  
  // Stats
  const [driverStats, setDriverStats] = useState({
    todayEarnings: 1850,
    totalRides: 12,
    onlineTime: 6,
    rating: 4.8
  });

  // Auth handlers
  if (!isLoggedIn) {
    if (authScreen === 'register') {
      return <RegisterScreen onBack={() => setAuthScreen('login')} />;
    }
    return (
      <LoginScreen 
        onLogin={() => setIsLoggedIn(true)}
        onRegister={() => setAuthScreen('register')}
      />
    );
  }

  // Driver handlers
  const handleToggleOnline = () => {
    setIsOnline(!isOnline);
    toast.success(isOnline ? "You're now offline" : "You're now online");
  };

  const handleAcceptPool = (poolId: string) => {
    const pool = pools.find(p => p.id === poolId);
    if (pool) {
      setActivePool(pool);
      setPools(pools.filter(p => p.id !== poolId));
      toast.success("Pool accepted! Navigate to first pickup location.");
    }
  };

  const handleCompleteRide = () => {
    if (activePool) {
      setDriverStats({
        ...driverStats,
        todayEarnings: driverStats.todayEarnings + activePool.totalEarnings,
        totalRides: driverStats.totalRides + activePool.customers.length
      });
      toast.success(`Pool completed! Earned ৳${activePool.totalEarnings}`);
      setCompletedPool(activePool);
      setShowRatingDialog(true);
      setActivePool(null);
      setShowNavigationMode(false);
    }
  };

  const handleCancelRide = () => {
    if (activePool) {
      setPools([activePool, ...pools]);
      setActivePool(null);
      setShowNavigationMode(false);
      toast.info("Ride cancelled");
    }
  };

  const handleSetPriority = (location: string) => {
    setPriorityLocation(location);
    updatePoolPriorities(location);
    toast.success(`Priority set to ${location}`);
  };

  const handleClearPriority = () => {
    setPriorityLocation(null);
    setPools(pools.map(pool => ({ ...pool, isPriority: false })));
    toast.info("Priority location cleared");
  };

  const updatePoolPriorities = (location: string) => {
    const updatedPools = pools.map(pool => ({
      ...pool,
      isPriority: pool.customers.some(c => 
        c.destination.toLowerCase().includes(location.toLowerCase())
      )
    }));
    
    const sortedPools = [
      ...updatedPools.filter(p => p.isPriority),
      ...updatedPools.filter(p => !p.isPriority)
    ];
    
    setPools(sortedPools);
  };

  const handleBackFromActiveRide = () => {
    if (showNavigationMode) {
      setShowNavigationMode(false);
    } else {
      handleCancelRide();
    }
  };

  const handleLogout = () => {
    setIsLoggedIn(false);
    setAuthScreen('login');
    toast.success("Logged out successfully");
  };

  const handleNavigateToSubScreen = (screen: Screen) => {
    setCurrentScreen(screen);
  };

  const handleBackToProfile = () => {
    setCurrentScreen('profile');
  };

  return (
    <SafeAreaView className="flex-1 bg-gray-50">
      <StatusBar barStyle="dark-content" />
      
      <AppHeader
        currentScreen={currentScreen}
        isOnline={isOnline}
        onToggleOnline={handleToggleOnline}
        onBack={activePool ? handleBackFromActiveRide : 
                ['settings', 'contactInfo', 'safety', 'help'].includes(currentScreen) ? handleBackToProfile : 
                currentScreen !== 'home' ? () => setCurrentScreen('home') : undefined}
        showNavigationMode={showNavigationMode}
        hasActiveRide={!!activePool}
      />

      <View className="flex-1">
        {currentScreen === 'home' && (
          <>
            {activePool ? (
              <ActiveRideScreen
                activePool={activePool}
                showNavigationMode={showNavigationMode}
                onComplete={handleCompleteRide}
                onCancel={handleCancelRide}
                onOpenNavigation={() => setShowNavigationMode(true)}
              />
            ) : (
              <HomeScreen
                pools={pools}
                selectedPoolForDetails={selectedPoolForDetails}
                onPoolSelect={setSelectedPoolForDetails}
                onAcceptPool={handleAcceptPool}
                priorityLocation={priorityLocation}
                showPriorityDialog={showPriorityDialog}
                setShowPriorityDialog={setShowPriorityDialog}
                onSetPriority={handleSetPriority}
                onClearPriority={handleClearPriority}
                showPromotions={showPromotions}
                setShowPromotions={setShowPromotions}
              />
            )}
          </>
        )}

        {currentScreen === 'earnings' && (
          <View className="p-4">
            <PromotionsBanner />
            <View className="h-6" />
            <EarningsScreen />
          </View>
        )}

        {currentScreen === 'profile' && (
          <View className="p-4">
            <ProfileScreen 
              onNavigateToSettings={() => handleNavigateToSubScreen('settings')}
              onNavigateToContactInfo={() => handleNavigateToSubScreen('contactInfo')}
              onNavigateToSafety={() => handleNavigateToSubScreen('safety')}
              onNavigateToHelp={() => handleNavigateToSubScreen('help')}
              onLogout={handleLogout}
            />
          </View>
        )}

        {currentScreen === 'settings' && (
          <SettingsScreen onBack={handleBackToProfile} />
        )}

        {currentScreen === 'contactInfo' && (
          <ContactInfoScreen 
            onBack={handleBackToProfile} 
            onSave={(data) => {
              console.log('Contact info saved:', data);
              handleBackToProfile();
            }}
          />
        )}

        {currentScreen === 'safety' && (
          <SafetySecurityScreen onBack={handleBackToProfile} />
        )}

        {currentScreen === 'help' && (
          <HelpSupportScreen onBack={handleBackToProfile} />
        )}
      </View>

      <BottomNavigation
        currentScreen={currentScreen === 'settings' || currentScreen === 'contactInfo' || currentScreen === 'safety' || currentScreen === 'help' ? 'profile' : currentScreen}
        onNavigate={setCurrentScreen}
      />

      <Toaster />
      
      <RatingFeedbackDialog
        isOpen={showRatingDialog}
        onClose={() => setShowRatingDialog(false)}
        pool={completedPool}
      />
    </SafeAreaView>
  );
}